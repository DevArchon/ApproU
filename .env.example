# Environment Variables Configuration
# Copy this file to .env.local and fill in your values

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://approu.com
NEXT_PUBLIC_SITE_NAME=approU

# CMS Configuration (Choose one)
# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# Strapi
# STRAPI_API_URL=
# STRAPI_API_TOKEN=

# Contentful
# CONTENTFUL_SPACE_ID=
# CONTENTFUL_ACCESS_TOKEN=
# CONTENTFUL_PREVIEW_ACCESS_TOKEN=

# Analytics
NEXT_PUBLIC_GA_TRACKING_ID=
NEXT_PUBLIC_HOTJAR_ID=

# Form Handling
# Zoho CRM
ZOHO_API_URL=
ZOHO_ACCESS_TOKEN=

# approU API
APPROU_API_URL=
APPROU_API_KEY=

# Email Configuration
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL=info@approu.com

# reCAPTCHA
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Development
NODE_ENV=development
